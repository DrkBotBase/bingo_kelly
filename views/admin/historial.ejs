<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Historial de Partidas - <%= name_page %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body class="bg-gray-100 min-h-screen">
    <nav class="bg-white shadow-md sticky top-0 z-10">
        <div class="container mx-auto px-4 py-3 flex justify-between items-center">
            <div class="flex items-center space-x-4">
                <a href="/admin/dashboard" class="text-gray-600 hover:text-blue-600 transition">
                    <i class="fa-solid fa-arrow-left text-xl"></i>
                </a>
                <h1 class="text-xl font-bold text-gray-800">📋 Historial de Partidas</h1>
            </div>
            <button onclick="limpiarHistorial()" class="bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded-lg text-sm transition">
                <i class="fa-solid fa-trash-can mr-2"></i>Vaciar Historial
            </button>
        </div>
    </nav>

    <div class="container mx-auto px-4 py-8">
        <% if (partidas && partidas.length > 0) { %>
            <div class="bg-white rounded-xl shadow-lg overflow-hidden">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-50 border-b">
                            <th class="px-6 py-4 font-bold text-gray-700">Fecha</th>
                            <th class="px-6 py-4 font-bold text-gray-700">Modalidad</th>
                            <th class="px-6 py-4 font-bold text-gray-700">Estado</th>
                            <th class="px-6 py-4 font-bold text-gray-700">Bolas</th>
                            <th class="px-6 py-4 font-bold text-gray-700">Ganadores</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y">
                        <% partidas.forEach(partida => { %>
                            <tr class="hover:bg-gray-50 transition">
                                <td class="px-6 py-4">
                                    <div class="text-sm font-semibold text-gray-900">
                                        <%= new Date(partida.fecha).toLocaleDateString() %>
                                    </div>
                                    <div class="text-xs text-gray-500">
                                        <%= new Date(partida.fecha).toLocaleTimeString() %>
                                    </div>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="px-2 py-1 bg-blue-100 text-blue-700 rounded text-xs font-bold uppercase">
                                        <%= partida.modalidad %>
                                    </span>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="px-2 py-1 <%= partida.estadoFinal === 'completado' ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700' %> rounded text-xs font-bold capitalize">
                                        <%= partida.estadoFinal %>
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-sm font-medium">
                                    <%= partida.totalBolas || 0 %> bolas
                                </td>
                                <td class="px-6 py-4">
                                    <% if (partida.ganadores && partida.ganadores.length > 0) { %>
                                        <div class="space-y-1">
                                            <% partida.ganadores.forEach(g => { %>
                                                <div class="text-xs">
                                                    <span class="font-bold text-blue-600">#<%= g.cartonId %></span> 
                                                    - <span class="text-gray-700"><%= g.nombreJugador %></span>
                                                    <span class="text-gray-400 font-normal">(<%= g.tipo %>)</span>
                                                </div>
                                            <% }); %>
                                        </div>
                                    <% } else { %>
                                        <span class="text-gray-400 text-xs italic">Sin ganadores</span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div class="bg-white rounded-xl shadow-lg p-12 text-center">
                <div class="text-5xl mb-4 text-gray-300">📭</div>
                <h3 class="text-xl font-bold text-gray-700 mb-2">No hay partidas registradas</h3>
                <p class="text-gray-500">Las partidas terminadas aparecerán aquí automáticamente.</p>
            </div>
        <% } %>
    </div>

    <script>
        async function limpiarHistorial() {
            if (!confirm('¿Estás seguro de que deseas eliminar todo el historial de partidas? Esta acción no se puede deshacer.')) return;
            
            try {
                const res = await fetch('/admin/api/historial/limpiar', { method: 'DELETE' });
                const data = await res.json();
                if (data.success) {
                    location.reload();
                } else {
                    alert('Error: ' + data.error);
                }
            } catch (e) {
                alert('Error de conexión');
            }
        }
    </script>
</body>
</html>
